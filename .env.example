ANTHROPIC_API_KEY=

# The API (`triage serve`). It won't start without a token. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRIAGE_API_TOKEN=
# Requests per minute per token
TRIAGE_RATE_LIMIT=10
# Seconds before POST /triage gives up with a 504
TRIAGE_TIMEOUT_S=90
TRIAGE_PROFILE=profile.yaml
